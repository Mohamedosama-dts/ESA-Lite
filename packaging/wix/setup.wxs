<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
    <!-- RepoRoot must be passed by candle: -dRepoRoot=<absolute-or-relative-repo-root> -->
    <Product Id="*" Name="!(loc.ProductName)" Language="$(var.Language)" Codepage="1256" Version="2.1.1" Manufacturer="!(loc.Manufacturer)" UpgradeCode="e7b2f1a4-1234-4567-89ab-cdef12345678">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" />

        <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="!(loc.DowngradeError)" />
        <MediaTemplate EmbedCab="yes" />

        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

        <WixVariable Id="WixUIBannerBmp" Value="$(var.RepoRoot)\assets\installer_banner.bmp" />
        <WixVariable Id="WixUIDialogBmp" Value="$(var.RepoRoot)\assets\installer_dialog.bmp" />
        <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

        <Icon Id="AppIcon.ico" SourceFile="$(var.RepoRoot)\assets\icon.ico"/>
        <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchAppText)" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <Property Id="WixShellExecTarget" Value="[#ESA_EXE]" />
        <!-- Immediate: ShellExecute as the interactive user after elevated MSI UI. -->
        <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

        <UI>
            <UIRef Id="WixUI_FeatureTree" />
            <!-- Must test CHECKBOX (value 1 when checked), not CHECKBOXTEXT (localized label). -->
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = "1" and NOT Installed</Publish>
        </UI>

        <Feature Id="MainProduct" Title="!(loc.FeatureMainTitle)" Description="!(loc.FeatureMainDesc)" Level="1" Display="expand" ConfigurableDirectory="INSTALLFOLDER">
            <ComponentGroupRef Id="ProductComponents" />
            <ComponentRef Id="SystemDrivers" />
            <ComponentRef Id="SystemDriversWow" />
            <ComponentRef Id="EnterSafeCryptoReg" />
            <ComponentRef Id="EnterSafeCryptoRegWow" />

            <Feature Id="ShortcutsFeature" Title="!(loc.FeatureShortcutTitle)" Description="!(loc.FeatureShortcutDesc)" Level="1">
                <ComponentRef Id="ApplicationShortcut" />
            </Feature>

            <Feature Id="DesktopShortcutFeature" Title="!(loc.FeatureDesktopTitle)" Description="!(loc.FeatureDesktopDesc)" Level="1">
                <ComponentRef Id="DesktopShortcut" />
            </Feature>

            <Feature Id="AutoStartFeature" Title="!(loc.FeatureAutoStartTitle)" Description="!(loc.FeatureAutoStartDesc)" Level="1">
                <ComponentRef Id="RegistryAutoRun" />
            </Feature>
        </Feature>

        <CustomAction Id="AddDefenderExclusion"
                      Directory="INSTALLFOLDER"
                      ExeCommand="powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -Command &quot;Add-MpPreference -ExclusionPath '[INSTALLFOLDER]'&quot;"
                      Execute="deferred"
                      Return="check"
                      Impersonate="no" />

        <InstallExecuteSequence>
            <Custom Action="AddDefenderExclusion" After="InstallFiles">NOT Installed</Custom>
        </InstallExecuteSequence>
    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="ESA-Lite" />
            </Directory>
            <!-- x64 package: System64Folder=System32, SystemFolder=SysWOW64 -->
            <Directory Id="System64Folder" />
            <Directory Id="SystemFolder" />
            <Directory Id="DesktopFolder" Name="Desktop" />
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="ESA-Lite"/>
            </Directory>
        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="a1b2c3d4-5678-90ab-cdef-1234567890ab" Win64="yes">
                <File Id="ESA_EXE" Source="$(var.RepoRoot)\dist_bin\ESA_Lite_v2.1.1.exe" Name="ESA_Lite.exe" KeyPath="yes" Checksum="yes" />
            </Component>
        </ComponentGroup>

        <!-- ePass PKCS#11 + CSP DLLs for Windows CryptoAPI / ITIDA (not only ESA-Lite). Permanent so external signers keep working after MSI remove. -->
        <DirectoryRef Id="System64Folder">
            <Component Id="SystemDrivers" Guid="c1d2e3f4-5678-90ab-cdef-1234567890ab" Win64="yes" Permanent="yes">
                <File Id="Driver1" Source="$(var.RepoRoot)\assets\drivers\x64\eps2003csp11.dll" KeyPath="yes" />
                <File Id="Driver2" Source="$(var.RepoRoot)\assets\drivers\x64\eps2003csp11_s.dll" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="SystemFolder">
            <Component Id="SystemDriversWow" Guid="a8b9c0d1-2345-6789-abcd-ef0123456789" Win64="no" Permanent="yes">
                <File Id="DriverWow1" Source="$(var.RepoRoot)\assets\drivers\x86\eps2003csp11.dll" KeyPath="yes" />
                <File Id="DriverWow2" Source="$(var.RepoRoot)\assets\drivers\x86\eps2003csp11_s.dll" />
            </Component>
        </DirectoryRef>

        <!-- EnterSafe CSP/KSP/Calais — native 64-bit view (ICE80: no [SystemFolder] here) -->
        <DirectoryRef Id="TARGETDIR">
            <Component Id="EnterSafeCryptoReg" Guid="b7c8d9e0-1234-5678-9abc-def012345678" Win64="yes" Permanent="yes">
                <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Cryptography\Defaults\Provider\EnterSafe ePass2003 CSP v1.0" ForceCreateOnInstall="yes">
                    <RegistryValue Name="Image Path" Type="string" Value="[System64Folder]eps2003csp11.dll" KeyPath="yes" />
                    <RegistryValue Name="Type" Type="integer" Value="1" />
                    <RegistryValue Name="Signature" Type="binary" Value="C7FB3DE5EB42B9070E36BD0FF58DEAAAC3B17A8F72BFE032ADD566136280B5C931E7DF471F773F3824ECC436942D0C749F44F674DB0503ACE83009ECEDED524D2F03E5D32C71D4DE2FFFAE50E7E95FC43785204A18D10688F676F0A4B357224B5BFD73C23E37511064C51FF731AD8DC4FF5845567EC13EF33F864855B3A5E41A0000000000000000" />
                </RegistryKey>
                <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Cryptography\Providers\EnterSafe ePass2003 Key Storage Provider\UM" ForceCreateOnInstall="yes">
                    <RegistryValue Name="Image" Type="string" Value="eps2003csp11.dll" />
                </RegistryKey>
                <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Cryptography\Providers\EnterSafe ePass2003 Key Storage Provider\UM\00010001" ForceCreateOnInstall="yes">
                    <RegistryValue Name="Flags" Type="integer" Value="1" />
                    <RegistryValue Name="Functions" Type="multiString">
                        <MultiStringValue>KEY_STORAGE</MultiStringValue>
                    </RegistryValue>
                </RegistryKey>
                <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Cryptography\Calais\SmartCards\ePass2003" ForceCreateOnInstall="yes">
                    <RegistryValue Name="Crypto Provider" Type="string" Value="EnterSafe ePass2003 CSP v1.0" />
                    <RegistryValue Name="ATR" Type="binary" Value="3B9F958131FE9F006646530500000071DF000000000000" />
                    <RegistryValue Name="ATRMask" Type="binary" Value="FFFFFFFFFFFFFFFFFFFFFFFF000000FFFFFFFFFFFFFF00" />
                </RegistryKey>
            </Component>
            <!-- 32-bit view for ITIDA (Win64=no → HKLM\SOFTWARE maps to WOW6432Node) -->
            <Component Id="EnterSafeCryptoRegWow" Guid="c9d0e1f2-3456-789a-bcde-f0123456789a" Win64="no" Permanent="yes">
                <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Cryptography\Defaults\Provider\EnterSafe ePass2003 CSP v1.0" ForceCreateOnInstall="yes">
                    <RegistryValue Name="Image Path" Type="string" Value="[SystemFolder]eps2003csp11.dll" KeyPath="yes" />
                    <RegistryValue Name="Type" Type="integer" Value="1" />
                    <RegistryValue Name="Signature" Type="binary" Value="C7FB3DE5EB42B9070E36BD0FF58DEAAAC3B17A8F72BFE032ADD566136280B5C931E7DF471F773F3824ECC436942D0C749F44F674DB0503ACE83009ECEDED524D2F03E5D32C71D4DE2FFFAE50E7E95FC43785204A18D10688F676F0A4B357224B5BFD73C23E37511064C51FF731AD8DC4FF5845567EC13EF33F864855B3A5E41A0000000000000000" />
                </RegistryKey>
                <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Cryptography\Calais\SmartCards\ePass2003" ForceCreateOnInstall="yes">
                    <RegistryValue Name="Crypto Provider" Type="string" Value="EnterSafe ePass2003 CSP v1.0" />
                    <RegistryValue Name="ATR" Type="binary" Value="3B9F958131FE9F006646530500000071DF000000000000" />
                    <RegistryValue Name="ATRMask" Type="binary" Value="FFFFFFFFFFFFFFFFFFFFFFFF000000FFFFFFFFFFFFFF00" />
                </RegistryKey>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="RegistryAutoRun" Guid="d1e2f3a4-5678-90ab-cdef-1234567890ab" Win64="yes">
                <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="ESA_Lite" Value="&quot;[INSTALLFOLDER]ESA_Lite.exe&quot; --tray" Type="string" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="b2c3d4e5-6789-0abc-def1-234567890abc">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="!(loc.ProductName)"
                          Description="!(loc.AppDescription)"
                          Target="[INSTALLFOLDER]ESA_Lite.exe"
                          WorkingDirectory="INSTALLFOLDER"/>
                <RemoveFolder Id="CleanupShortcut" Directory="ApplicationProgramsFolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\DTS\ESALite" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="DesktopFolder">
            <Component Id="DesktopShortcut" Guid="e1f2a3b4-5678-90ab-cdef-1234567890ab">
                <Shortcut Id="ApplicationDesktopShortcut"
                          Name="!(loc.ProductName)"
                          Description="!(loc.AppDescription)"
                          Target="[INSTALLFOLDER]ESA_Lite.exe"
                          WorkingDirectory="INSTALLFOLDER"/>
                <RegistryValue Root="HKCU" Key="Software\DTS\ESALite" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>
    </Fragment>
</Wix>
